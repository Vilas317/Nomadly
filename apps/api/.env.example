# Local PostgreSQL is exposed on host port 5433 by docker-compose.yml.
DATABASE_URL="postgresql://nomadly:nomadly_local_password@localhost:5433/nomadly?schema=public"
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-at-least-32-characters
# Generate 32 random bytes and encode as 64 hexadecimal characters.
REFRESH_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters

# Redis-backed authentication rate limiting. Redis is provided by docker-compose.yml.
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=2000

# Number of trusted reverse-proxy hops. Keep 0 for local development.
# Set to the exact proxy hop count only when deployed behind trusted proxies.
TRUST_PROXY_HOPS=0

# Dedicated HMAC key for Redis rate-limit identifiers (64 hexadecimal characters)
RATE_LIMIT_HMAC_SECRET=replace_with_64_character_hex_secret
